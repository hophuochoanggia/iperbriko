    .header-nav--figma .header__menu-item {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      height: 4.4rem;
      min-height: 4.4rem;
      max-height: none;
      padding: 0 1.6rem 0 0;
      margin: 0;
      font-size: 1.3rem;
      font-weight: 400;
      line-height: 1.2;
      color: #6b7280;
      text-decoration: none;
      border-bottom: 2px solid transparent;
      background: transparent;
      box-sizing: border-box;
    }

    .header-nav--figma summary.header__menu-item {
      list-style: none;
      cursor: pointer;
    }

    .header-nav--figma summary.header__menu-item::-webkit-details-marker {
      display: none;
    }

    .header-nav--figma .header__menu-item:hover,
    .header-nav--figma .mega-menu[open] > .header__menu-item {
      color: #2b5899;
      background: #f9fafb;
      border-bottom-color: #2a5798;
    }

    .header-nav--figma .header__menu-item span {
      font-size: inherit;
      font-weight: inherit;
      color: inherit;
      line-height: inherit;
    }

    /* Show category icons like live theme */
    .header-nav--figma .header__menu-item svg,
    .header-nav--figma .header__menu-item .icon {
      display: block;
      width: 2.4rem;
      height: 2.4rem;
      flex-shrink: 0;
    }

    .header-nav--figma .header__menu-item svg path {
      fill: #6b7280;
    }

    .header-nav--figma .header__menu-item:hover svg path,
    .header-nav--figma .mega-menu[open] > .header__menu-item svg path {
      fill: #2b5899;
    }

    .header-nav--figma .header__menu-item--shop-all {
      color: #274f94;
      font-weight: 700;
      gap: 0.6rem;
    }

    .header-nav--figma .header__menu-item--shop-all .icon-grid,
    .header-nav--figma .header__menu-item--shop-all svg {
      display: block;
      width: 1.6rem;
      height: 1.6rem;
      flex-shrink: 0;
      color: #274f94;
    }

    .header-nav--figma .header__menu-item--shop-all svg path {
      fill: none;
      stroke: #274f94;
    }

    .header-nav--figma .header__menu-item--sale,
    .header-nav--figma .list-menu > li .header__menu-item[data-sale='true'] {
      color: #ff3b3b;
      font-weight: 700;
    }

    @media screen and (max-width: 989px) {
      /* Stoney Creek mobile: [Menu][Account] | Logo | [Search][Cart] */
      .header--figma {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 0;
        min-height: 5.6rem;
        padding-left: 1.2rem !important;
        padding-right: 1.2rem !important;
      }

      .header__cluster--left {
        justify-self: start;
        min-width: 8.8rem;
        position: relative;
        z-index: 2;
        padding-left: 0;
        margin-left: 0;
      }

      .header--figma header-drawer.menu-mobile {
        margin-left: 0;
        padding-left: 0;
      }

      .header--figma .header__heading {
        justify-self: center;
        margin: 0;
        z-index: 1;
      }

      .header__cluster--right {
        justify-self: end;
        margin-left: 0;
        gap: 0;
        z-index: 2;
        min-width: 8.8rem;
        justify-content: flex-end;
      }

      .header__icons--figma .header__icon,
      .header__cluster--left .header__icon,
      .header__account--actions .header__icon {
        width: 4.4rem;
        height: 4.4rem;
      }

      .header--figma .menu-mobile .header__icon--menu,
      .header--figma header-drawer.menu-mobile .header__icon--menu {
        width: 4.4rem;
        height: 4.4rem;
        background: transparent !important;
        border: 0;
        box-shadow: none;
      }

      .header--figma .menu-mobile .header__icon--menu span,
      .header--figma header-drawer.menu-mobile .header__icon--menu span {
        background: transparent !important;
      }

      /* Hamburger + account stay inline in left cluster (no absolute) */
      .header__cluster--left .header__account--actions {
        position: static;
        transform: none;
        top: auto;
        left: auto;
      }

      .header-search-modal--mobile {
        display: block;
      }

      .header-search-figma.header-search-figma--desktop {
        display: none !important;
      }

      .header__icon--wishlist {
        display: none !important;
      }

      .header--figma .header__heading-logo-wrapper {
        max-width: 12rem;
      }

      .cart-count-bubble--figma {
        top: 0.2rem;
        right: 0.2rem;
      }
    }
  </style>

