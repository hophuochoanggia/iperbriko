{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'section-related-products.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
<div class=" page-width tw-relative">
  <div class="tab-customize  tw-mt-4 md:tw-mt-[120px] sm:tw-flex  tw-hidden">
    {% if product.description != blank %}
      <button
        class="tablinks-cus tw-font-semibold  tw-text-sm"
        onclick="openTab(event, 'tab-1')"
        id="tab-cus-active"
      >
        Product Description
      </button>
    {% endif %}
    {% if product.metafields.info_tab != blank %}
      {% if product.metafields.info_tab.shipping_information != blank %}
        <button
          class="tablinks-cus tw-font-semibold  tw-text-sm"
          onclick="openTab(event, 'tab-shipping_information')"
        >
          Shipping Information
        </button>
      {% endif %}
      {% if product.metafields.info_tab.review != blank %}
        <button
          class="tablinks-cus tw-font-semibold  tw-text-sm"
          onclick="openTab(event, 'tab-review')"
        >
          Review
        </button>
      {% endif %}
      {% if product.metafields.info_tab.faqs != blank %}
        <button
          class="tablinks-cus tw-font-semibold  tw-text-sm"
          onclick="openTab(event, 'tab-faqs')"
        >
          FAQs
        </button>
      {% endif %}

      {% for tab in product.metafields.info_tab %}
      {% endfor %}
    {% endif %}
    <div class="btn_last ">&nbsp;</div>
  </div>

  <slider-component class="sm:tw-hidden slider-mobile-gutter scroll-trigger animate--slide-in  tw-mt-4 md:tw-mt-[120px]">
    <div
      class=" !tw-auto-cols-max tw-gap-0 tab-customize slider slider--desktop slider--tablet tw-pb-8 collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} grid-scroll grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down{% if section.settings.swipe_on_mobile %} slider slider--desktop slider--tablet grid--peek{% endif %} "
      id="Slider-{{ section.id }}"
      role="list"
    >
      {% if product.description != blank %}
        <button
          class="tablinks-cus tw-font-semibold  tw-text-sm"
          onclick="openTab(event, 'tab-1')"
          id="tab-cus-active"
        >
          Product Description
        </button>
      {% endif %}
      {% if product.metafields.info_tab != blank %}
        {% if product.metafields.info_tab.shipping_information != blank %}
          <button
            class="tablinks-cus tw-font-semibold  tw-text-sm"
            onclick="openTab(event, 'tab-shipping_information')"
          >
            Shipping Information
          </button>
        {% endif %}
        {% if product.metafields.info_tab.review != blank %}
          <button
            class="tablinks-cus tw-font-semibold  tw-text-sm"
            onclick="openTab(event, 'tab-review')"
          >
            Review
          </button>
        {% endif %}
        {% if product.metafields.info_tab.faqs != blank %}
          <button
            class="tablinks-cus tw-font-semibold  tw-text-sm"
            onclick="openTab(event, 'tab-faqs')"
          >
            FAQs
          </button>
        {% endif %}

        {% for tab in product.metafields.info_tab %}
        {% endfor %}
      {% endif %}
      <div class="btn_last ">&nbsp;</div>
    </div>
  </slider-component>
  <!-- Tab content -->
  <div class="tw-flex ">
    <div id="tab-1" class="tabcontent-cus ">{{ product.description }} llllll</div>

    {% if product.metafields.info_tab != blank %}
      {%- for tab in product.metafields.info_tab -%}
        <div id="tab-{{tab[0]}}" class="tabcontent-cus">
          {{ tab | last | strip_html }}
        </div>
      {%- endfor -%}
    {% endif %}
  </div>
</div>
<style>
  ol {
    all: unset;
  }
  .btn_last {
    flex-grow: 999;
    border-bottom: 2px solid #ccc;
  }
  .tab-customize {
    border: none;
    margin-bottom: 32px;
    grid-auto-columns: max-content !important;

    {% comment %} display: flex; {% endcomment %}
  }
  .tab-customize button {
    cursor: pointer;
    padding: 16px;
    transition: 0.3s;
    display: block;
    flex-grow: 0;
    border: none;
    border-bottom: 2px solid #ccc;
    justify-self: start;

  }

  .tab-customize button.active {
    border-bottom: 2px solid black;
    z-index: 100;
  }
  .tabcontent-cus {
    display: none;
    padding: 6px;
    border: 1px solid #ccc;
    border: none;
    min-height: 200px;
  }
</style>
