{{ 'section-quiz-form.css' | asset_url | stylesheet_tag }}
<script src="{{ 'quiz-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'download.js' | asset_url }}" defer="defer"></script>
<script src="https://www.google.com/recaptcha/api.js" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  .bg {
    position: absolute;
    background: url("/assets/gray-layer.png") no-repeat center center;
    background-size: cover;
    top: 100;
    left: 0;
    width: 100%;
    height: 100%;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }


  @media screen and (min-width: 1920px) {
    .bg {
      position: absolute;
      background: url("/assets/gray-layer.png") no-repeat center center;
      background-size: cover;
      top: 0;
      left: 0;
      width: 100%;
      height:180%;
    }
  }
{%- endstyle -%}

{%- liquid
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'

  assign columns_mobile_int = section.settings.columns_mobile | plus: 0
  assign show_mobile_slider = false

  assign field_class = 'tw-flex tw-flex-col tw-mb-2'
  assign input_class = 'tw-full tw-bg-gray-100 tw-p-4 tw-border tw-border-gray-300 focus:tw-outline-none focus:tw-ring-1 focus:tw-ring-medium tw-rounded-md tw-mt-2 tw-mb-4 '

  assign label_class = 'tw-text-text-black tw-font-bold tw-flex'

  if section.settings.swipe_on_mobile and section.blocks.size > columns_mobile_int
    assign show_mobile_slider = true
  endif
-%}

<div class="section-{{ section.id }}-padding gradient  tw-pt-24 tw-pb-20  tw-relative  tw-overflow-hidden tw-min-h-screen">
  <div class="bg">&nbsp;</div>

  <div
    id="quiz-form"
    class="quiz-form  tw-relative tw-text-black tw-text-base page-width tw-flex tw-flex-col tw-justify-center tw-items-center tw-text-center "
  >
    <div class="tw-px-4 md:tw-px-0 tw-flex tw-flex-col tw-justify-center tw-items-center tw-w-full">
      <div class="tw-flex tw-flex-col tw-justify-between tw-items-center ">
        <div class="tw-text-5xl tw-font-semibold tw-pb-4 {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </div>
        <p class="tw-text-center tw-w-full lg:tw-w-2/3">
          {{ section.settings.description }}
        </p>

        <div id="progress" class="tw-flex tw-items-center tw-justify-center hidden tw-my-10 tw-w-full">
          <div
            id="progress-border-2"
            class="tw-w-10 tw-h-10 tw-rounded-full tw-border-2 tw-flex tw-justify-center tw-items-center"
          >
            <div id="progress-bg-2" class=" tw-w-4 tw-h-4 tw-rounded-full">&nbsp;</div>
            <div id="progress-tick-2" class="hidden">
              {% render 'icon-tick', color: '#000', size: '24px' %}
            </div>
          </div>
          <div id="progress-bar-2" class="tw-w-10 tw-border tw-h-0">&nbsp;</div>

          <div
            id="progress-border-3"
            class="tw-w-10 tw-h-10 tw-rounded-full tw-border-2 tw-flex tw-justify-center tw-items-center tw-border-gray-light"
          >
            <div id="progress-bg-3" class=" tw-w-4 tw-h-4 tw-rounded-full">&nbsp;</div>
            <div id="progress-tick-3" class="hidden">
              {% render 'icon-tick', color: '#000', size: '24px' %}
            </div>
          </div>
        </div>
      </div>

      <div id="step-1" class="tw-flex tw-flex-col tw-space-y-4 quiz-form__step ">
        <div class="tw-flex tw-flex-col lg:tw-flex-row tw-w-full tw-h-full tw-pt-14 ">
          <div
            class=" scroll-trigger animate--fade-in tw-relative"
          >
            {%- liquid
              assign sizes = full_width
              assign fetch_priority = 'high'
            -%}
            {{
              section.settings.image_quiz
              | image_url: width: 3840
              | image_tag:
                width: section.settings.image_quiz.width,
                sizes: sizes,
                widths: widths,
                fetchpriority: fetch_priority,
                class: 'tw-rounded-2xl tw-h-[400px]'
            }}

            <div class="tw-absolute tw-top-0 tw-left-0 tw-w-full tw-h-full tw-flex tw-flex-col tw-justify-center tw-items-center tw-space-y-4 tw-px-8">
              <p class="tw-text-base tw-text-white">
                {{ section.settings.quiz_description }}
              </p>
              <span
                class="button button--primary tw-text-black tw-uppercase"
                onclick="switchSlider(2)"
                id="start-quiz-button"
              >
                <span class="btn tw-text-base">{{ section.settings.button_quiz_label }}</span>
              </span>
            </div>
          </div>
          <div class="tw-px-8 tw-py-4 tw-flex tw-items-center tw-justify-center">OR</div>
          <div
            class=" scroll-trigger animate--fade-in tw-relative"
          >
            {%- liquid
              assign sizes = full_width
              assign fetch_priority = 'high'
            -%}
            {{
              section.settings.image_download
              | image_url: width: 3840
              | image_tag:
                width: section.settings.image_download.width,
                sizes: sizes,
                widths: widths,
                fetchpriority: fetch_priority,
                class: 'tw-rounded-2xl tw-h-[400px]'
            }}

            <div class="tw-absolute tw-top-0 tw-left-0 tw-w-full tw-h-full tw-flex tw-flex-col tw-justify-center tw-items-center tw-space-y-4 tw-px-8">
              <p class="tw-text-base tw-text-white">
                {{ section.settings.download_description }}
