{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'section-featured-blog.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 1 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 1 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="page-width  tw-w-full scroll-trigger animate--fade-in section-{{ section.id }}-padding">
  <div
    id="SectionHeading-{{ section.id }}"
    class="{{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %} tw-text-[25px] tw-font-semibold tw-leading-8 tw-flex tw-flex-col tw-gap-y-2 tw-w-full tw-justify-center tw-items-center"
    {% if settings.animations_reveal_on_scroll %}
      data-cascade
    {% endif %}
  >
    {{ section.settings.heading }}
  </div>

  <slider-component class="tw-w-full slider-mobile-gutter section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <ul
      id="Slider-{{ section.id }}"
      class="tw-grid  tw-grid-col tw-grid-cols-1 lg:tw-grid-cols-2 tw-w-full tw-gap-6"
      role="list"
    >
      {%- for block in section.blocks -%}
        <li
          id="Slide-{{ section.id }}-{{ forloop.index }}"
          class="
            tw-w-full tw-cols-span-1
            tw-cursor-pointer
            {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}
          "
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          {% render 'delivery-help-card',
            block: block,
            media_aspect_ratio: 1.66,
            with_border_radius: true,
            image_overlay_opacity: 1
          %}
        </li>
      {%- endfor -%}
    </ul>
  </slider-component>
</div>

{% schema %}
{
  "name": "t:sections.delivery.name",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "Our Services",
      "label": "t:sections.our-service.settings.heading.label"
    },
    {
      "type": "select",
      "id": "desktop_content_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.our-service.settings.desktop_content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.our-service.settings.desktop_content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.our-service.settings.desktop_content_alignment.options__3.label"
        }
      ],
      "default": "center",
      "label": "t:sections.our-service.settings.desktop_content_alignment.label"
    },
    {
      "type": "header",
      "content": "t:sections.our-service.header.content"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.our-service.settings.columns_desktop.label"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1,
      "label": "t:sections.our-service.settings.columns_mobile.label"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "service-card",
      "name": "Card",
      "settings": [

        {
          "type": "text",
          "id": "background-color",
          "label": "background color",
          "default": "#f1ece2"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "heading",
          "default": "Card"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Card Description"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "radio",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            { "value": "top-left", "label": "top-left" },
            { "value": "top-center", "label": "top-center" },
            { "value": "top-right", "label": "top-right" },
            { "value": "center-left", "label": "center-left" },
            { "value": "center-center", "label": "center-center" },
            { "value": "center-right", "label": "center-right" },
            { "value": "bottom-left", "label": "bottom-left" },
            { "value": "bottom-center", "label": "bottom-center" },
            { "value": "bottom-right", "label": "bottom-right" }
          ],
          "default": "bottom-left"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "CTA Text",
          "default": "Click Here"
        },
        {
          "type": "url",
          "id": "url",
          "label": "CTA URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.our-service.presets.name",
      "blocks": []
    }
  ]
}
{% endschema %}
