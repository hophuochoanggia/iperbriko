{% comment %}
  Renders a header search modal. Should be used with 'header.liquid'

  Accepts:
  - input_id: {String} Id for the search input element (required)

  Usage:
  {% render 'header-search', input_id: 'My-Id'%}
{% endcomment %}

<details-modal class="header-search-modal header-search-modal--mobile">
  <details>
    <summary
      class="header__icon header__icon--search header__icon--summary focus-inset modal__toggle"
      aria-haspopup="dialog"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <span class="header-search-modal__icon modal__toggle-open">
        {% render 'icon-search-blue' %}
      </span>
      <span class="header-search-modal__icon modal__toggle-close">
        <svg class="icon icon-close" aria-hidden="true" focusable="false" width="18" height="17">
          <use href="#icon-close">
        </svg>
      </span>
    </summary>
    <div
      class="search-modal modal__content gradient"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.search.search' | t }}"
    >
      <div class="modal-overlay"></div>
      <div
        class="search-modal__content{% if settings.inputs_shadow_vertical_offset != 0 and settings.inputs_shadow_vertical_offset < 0 %} search-modal__content-top{% else %} search-modal__content-bottom{% endif %}"
        tabindex="-1"
      >
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="search-modal__form">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
          <div class="field">
            <input
              class="search__input tw-py-2 tw-px-10 tw-outline-none tw-shadow-none tw-w-full"
              id="{{ input_id }}"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ 'general.search.header' | t }}"
              {%- if settings.predictive_search_enabled -%}
                role="combobox"
                aria-expanded="false"
                aria-owns="predictive-search-results"
                aria-controls="predictive-search-results"
                aria-haspopup="listbox"
                aria-autocomplete="list"
                autocorrect="off"
                autocomplete="off"
                autocapitalize="off"
                spellcheck="false"
              {%- endif -%}
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button
              type="reset"
              class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
              aria-label="{{ 'general.search.reset' | t }}"
            >
              <svg class="icon icon-close" aria-hidden="true" focusable="false">
                <use xlink:href="#icon-reset">
              </svg>
            </button>
            <button
              class="search__button field__button"
              aria-label="{{ 'general.search.header' | t }}"
            >
              {% render 'icon-search-blue' %}
            </button>
          </div>

          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
            </div>

            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}
        <button
          type="button"
          class="search-modal__close-button modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <svg class="icon icon-close" aria-hidden="true" focusable="false">
            <use href="#icon-close">
          </svg>
        </button>
      </div>
    </div>
  </details>
</details-modal>

{%- if settings.predictive_search_enabled -%}
  <predictive-search
    class="search-modal__form header-search-figma header-search-figma--desktop"
    data-loading-text="{{ 'accessibility.loading' | t }}"
  >
    <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
      <div class="header-search-figma__field">
        <input
          class="search__input header-search-figma__input"
          id="{{ input_id }}-desktop"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.header' | t }}"
          role="combobox"
          aria-expanded="false"
          aria-owns="predictive-search-results"
          aria-controls="predictive-search-results"
          aria-haspopup="listbox"
          aria-autocomplete="list"
          autocorrect="off"
          autocomplete="off"
          autocapitalize="off"
          spellcheck="false"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button
          type="reset"
          class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
          aria-label="{{ 'general.search.reset' | t }}"
        >
          <svg class="icon icon-close" aria-hidden="true" focusable="false">
            <use xlink:href="#icon-reset">
          </svg>
        </button>

        <button
          class="header-search-figma__submit"
          aria-label="{{ 'general.search.header' | t }}"
        >
          {% render 'icon-search-blue' %}
        </button>
      </div>

      <div class="predictive-search predictive-search--header" tabindex="-1" data-predictive-search>
      </div>

      <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
    </form>
  </predictive-search>
{%- else -%}
  <search-form class="search-modal__form header-search-figma header-search-figma--desktop">
    <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
      <div class="header-search-figma__field">
        <input
          class="search__input header-search-figma__input"
          id="{{ input_id }}-desktop"
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'general.search.header' | t }}"
        >
        <input type="hidden" name="options[prefix]" value="last">
        <button
          class="header-search-figma__submit"
          aria-label="{{ 'general.search.header' | t }}"
        >
          {% render 'icon-search-blue' %}
        </button>
      </div>
    </form>
  </search-form>
{%- endif -%}

<style>
  .header-search-figma {
    flex: 1 1 auto;
    min-width: 0;
    max-width: none;
  }

  .header-search-figma__field {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    height: 4.8rem;
    padding: 0 0.8rem 0 1.6rem;
    background: #fff;
    border: 1px solid #274f94;
    border-radius: 0.8rem;
  }

  .header-search-figma__input {
    flex: 1 1 auto;
    min-width: 0;
    height: 100%;
    border: none;
    outline: none;
    box-shadow: none;
    background: transparent;
    font-size: 1.4rem;
    color: #111827;
  }

  .header-search-figma__input::placeholder {
    color: #9ca3af;
  }

  .header-search-figma__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.8rem;
    height: 4rem;
    border: none;
    background: transparent;
    color: #274f94;
    cursor: pointer;
    border-radius: 0.6rem;
    flex-shrink: 0;
  }

  .header-search-figma__submit .icon {
    width: 1.8rem;
    height: 1.8rem;
  }
</style>
