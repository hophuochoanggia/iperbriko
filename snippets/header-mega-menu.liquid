{% comment %}
  Renders a megamenu for the header.

  Usage:
  {% render 'header-mega-menu' %}
{% endcomment %}

<nav id="header-mega-menu" class="header__inline-menu">
  <ul class="list-menu list-menu--inline" role="list">
    <li class="header-nav__shop-all">
      <a
        href="{{ section.settings.shop_all_link | default: routes.all_products_collection_url }}"
        class="header__menu-item list-menu__item link focus-inset header__menu-item--shop-all"
      >
        {% render 'icon-grid' %}
        <span>{{ section.settings.shop_all_label | default: 'Shop All' | escape }}</span>
      </a>
    </li>
    <li class="header-nav__divider" aria-hidden="true"></li>
    {%- for block in section.blocks -%}
      {%- liquid
        assign menu_label = block.settings.text | strip
        assign menu_label_downcase = menu_label | downcase
        assign is_sale = false
        if menu_label_downcase contains 'sale' or menu_label_downcase contains 'promo' or menu_label_downcase contains 'offerte'
          assign is_sale = true
        endif

        assign has_promo = false
        if block.settings.promo_image != blank or block.settings.promo_heading != blank
          assign has_promo = true
        endif
      -%}
      <li>
        <header-menu>
          <details
            id="Details-HeaderMenu-{{ forloop.index }}"
            class="mega-menu"
          >
            <summary
              id="HeaderMenu-{{ block.settings.menu }}"
              data-menu="{{ block.settings.menu }}"
              class="header__menu-item list-menu__item link focus-inset{% if is_sale %} header__menu-item--sale{% endif %}"
              {% if is_sale %}data-sale="true"{% endif %}
            >
              {% render 'header-nav-icon', icon: block.settings.icon, menu: block.settings.menu %}
              <span>
                {{ block.settings.text | escape }}
              </span>
            </summary>
            <div
              id="MegaMenu-Content-{{ forloop.index }}"
              class="mega-menu__content color-{{ section.settings.menu_color_scheme }} gradient motion-reduce global-settings-popup{% if has_promo %} mega-menu__content--with-promo{% endif %}"
              tabindex="-1"
            >
              <div class="mega-menu__sidebar">
                <ul class="mega-menu__sidebar-list">
                  {%- for link in block.settings.menu.links -%}
                    <li
                      class="mega-menu__item {% if forloop.first %}mega-menu__item-first mega-menu__item-active{% endif %} {% if forloop.last %}mega-menu__item-last{% endif %}"
                    >
                      <a
                        id="HeaderMenu-{{ link.handle }}"
                        href="{{ link.url }}"
                        class="mega-menu__item-link"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title }}
                      </a>
                      <div class="mega-menu__list-item">
                        {% for childlink in link.links %}
                          <div class="mega-menu__column">
                            <a
                              id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="mega-menu__child-item mega-menu__link link {% if childlink.current %}mega-menu__link--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ childlink.title }}
                            </a>
                            {% if childlink.links.size > 0 %}
                              <ul class="mega-menu__grandchild-list">
                                {% for grandchildlink in childlink.links %}
                                  <li class="mega-menu__grandchild-item">
                                    <a
                                      id="HeaderMenu-{{ link.handle }}-{{ childlink.handle }}-{{ grandchildlink.handle }}"
                                      href="{{ grandchildlink.url }}"
                                      class="mega-menu__link link{% if grandchildlink.current %} mega-menu__link--active{% endif %}"
                                      {% if grandchildlink.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {{- grandchildlink.title -}}
                                    </a>
                                  </li>
                                {% endfor %}
                              </ul>
                            {% endif %}
                          </div>
                        {% endfor %}
                      </div>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              {% render 'mega-menu-promo-card',
                image: block.settings.promo_image,
                heading: block.settings.promo_heading,
                link: block.settings.promo_link
              %}
            </div>
          </details>
        </header-menu>
      </li>
    {% endfor %}
  </ul>
</nav>
