        "text_mVWBFw": {
          "type": "text",
          "settings": {
            "text": "<p>In Italia, il periodo natalizio dura 29 giorni, dal 8 dicembre al 6 gennaio, con tradizioni e festività caratteristiche.</p>"
          }
        }
      },
      "block_order": [
