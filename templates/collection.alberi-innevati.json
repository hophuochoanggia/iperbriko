      "type": "rich-text",
      "blocks": {
        "heading_TqcPQB": {
          "type": "heading",
          "settings": {
            "heading": "<strong>Come scegliere l'albero di Natale verde adatto al tuo spazio</strong>",
            "heading_size": "h2"
          }
        },
        "text_cMbpBb": {
          "type": "text",
